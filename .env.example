# ─────────────────────────────────────────────────────────────
#  NodeKart — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Set to "true" ONLY when testing with a real MetaMask wallet.
# When "false" the app runs in safe demo/mock mode with no wallet required.
VITE_METAMASK_ENABLED=false

# Deploy NodeKartEscrow.sol (see src/contracts/) and paste the
# deployed contract address here.
VITE_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain ID for the target network.
# 1          = Ethereum Mainnet
# 11155111   = Sepolia Testnet  ← recommended for development
# 137        = Polygon Mainnet
VITE_CHAIN_ID=11155111

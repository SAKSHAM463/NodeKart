# Enable real MetaMask / Web3 wallet transactions
VITE_METAMASK_ENABLED=true

# Chain ID for the target network.
# 11155111 = Ethereum Sepolia Testnet
# 84532    = Base Sepolia
# 31337    = Local Hardhat/Anvil node
# 1        = Ethereum Mainnet
VITE_CHAIN_ID=11155111
